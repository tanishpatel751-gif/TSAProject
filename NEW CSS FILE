
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:         #f8fafc;
  --card:       #ffffff;
  --ink:        #0f172a;
  --ink-soft:   #475569;
  --accent:     #2563eb;
  --accent-lt:  #dbeafe;
  --accent-dk:  #1d4ed8;
  --border:     #e2e8f0;
  --radius:     12px;
  --shadow:     0 8px 40px rgba(0,0,0,.08);
  --trans:      .2s ease;
  --font-body:  'DM Sans', 'Helvetica Neue', sans-serif;
  --font-mono:  'JetBrains Mono', 'Fira Code', monospace;
}

body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--ink);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 16px;
}

.shell {
  width: 100%;
  max-width: 580px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.progress-label,
.progress-pct {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ink-soft);
}

.progress-track {
  height: 4px;
  background: var(--border);
  border-radius: 99px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  width: 0%;
  background: var(--accent);
  border-radius: 99px;
  transition: width .5s cubic-bezier(.4,0,.2,1);
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 48px 52px 44px;
  display: flex;
  flex-direction: column;
  gap: 26px;
}

.q-meta { margin-bottom: -10px; }
.q-number {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--accent);
  text-transform: uppercase;
}
.q-text {
  font-size: clamp(17px, 3vw, 21px);
  font-weight: 400;
  line-height: 1.5;
  color: var(--ink);
}

.choices {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.choice {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 13px 16px;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  cursor: pointer;
  transition: border-color var(--trans), background var(--trans);
  user-select: none;
}
.choice:hover {
  border-color: var(--accent);
  background: var(--accent-lt);
}
.choice.selected {
  border-color: var(--accent);
  background: var(--accent-lt);
}
.choice.selected .choice-letter {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.choice-letter {
  flex-shrink: 0;
  width: 26px;
  height: 26px;
  border-radius: 6px;
  background: var(--bg);
  border: 1.5px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  color: var(--ink-soft);
  transition: background var(--trans), border-color var(--trans), color var(--trans);
}
.choice-text {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--ink);
  padding-top: 3px;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 4px;
}

.btn-back,
.btn-next {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: .07em;
  padding: 11px 28px;
  border-radius: 8px;
  border: 1.5px solid transparent;
  cursor: pointer;
  transition: background var(--trans), color var(--trans),
              border-color var(--trans), opacity var(--trans);
}

.btn-back {
  background: transparent;
  border-color: var(--border);
  color: var(--ink-soft);
}
.btn-back:hover:not(:disabled) {
  border-color: var(--ink-soft);
  color: var(--ink);
}
.btn-back:disabled { opacity: .3; cursor: default; }

.btn-next {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.btn-next:hover:not(:disabled) { background: var(--accent-dk); }
.btn-next:disabled { opacity: .35; cursor: default; }

.result-card {
  text-align: center;
  align-items: center;
  gap: 18px;
}
.result-heading {
  font-size: clamp(20px, 4vw, 25px);
  font-weight: 600;
  line-height: 1.3;
  color: var(--ink);
  font-style: italic;
}
.result-sub {
  font-size: 14.5px;
  color: var(--ink-soft);
  line-height: 1.7;
  max-width: 400px;
}

@keyframes bounceIn {
  0%   { opacity: 0; transform: translateY(12px); }
  55%  { opacity: 1; transform: translateY(-4px); }   
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes fadeOut {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-8px); }
}

.card.entering { animation: bounceIn .35s ease both; }
.card.exiting  { animation: fadeOut .18s ease forwards; pointer-events: none; }

@media (max-width: 500px) {
  .card { padding: 32px 24px 28px; }
}
