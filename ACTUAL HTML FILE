<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quiz</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <div class="shell">

    <!-- Top bar -->
    <div class="top-bar">
      <span class="progress-label" id="progressLabel">Question 1 of 8</span>
      <span class="progress-pct"   id="progressPct">0%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progressFill"></div>
    </div>

    <!-- Prompt card (shown first) -->
    <div class="card" id="promptCard">
      <div class="q-meta">
        <span class="q-number">00 —</span>
      </div>
      <h2 class="q-text">Before we begin</h2>
      <p class="result-sub" style="margin-bottom: 1.2rem;">
        Enter a prompt or note that will be sent along with your results.
      </p>
      <textarea
        id="userPrompt"
        placeholder="Type your prompt here..."
        rows="4"
        style="
          width: 100%;
          box-sizing: border-box;
          padding: 0.75rem 1rem;
          font-family: inherit;
          font-size: 1rem;
          border: 2px solid var(--border, #ccc);
          border-radius: 8px;
          resize: vertical;
          background: transparent;
          color: inherit;
          margin-bottom: 1.5rem;
        "
      ></textarea>
      <div class="nav" style="justify-content: flex-end;">
        <button class="btn-next" id="btnStartQuiz">Start Quiz</button>
      </div>
    </div>

    <!-- Quiz card -->
    <div class="card" id="card">
      <div class="q-meta">
        <span class="q-number" id="qNumber">01 —</span>
      </div>
      <h2 class="q-text" id="qText"></h2>
      <div class="choices" id="choices"></div>
      <div class="nav">
        <button class="btn-back" id="btnBack" disabled>Back</button>
        <button class="btn-next" id="btnNext" disabled>Next</button>
      </div>
    </div>

    <!-- Result card (hidden until complete) -->
    <div class="card result-card" id="resultCard" hidden>
      <p class="q-number" id="outcomeLabel">Result —</p>
      <h2 class="result-heading" id="resultHeading">Calculating...</h2>
      <p class="result-sub" id="resultSub"></p>
      <div class="nav" style="justify-content:center;">
        <button class="btn-next" id="btnRestart">Take it again</button>
      </div>
    </div>

  </div>

  <script src="quiz.js"></script>
</body>
</html>
